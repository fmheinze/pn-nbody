# Test for a Newtonian binary


# -------------------------------------------------------------------------------------------------
# General parameters
# -------------------------------------------------------------------------------------------------
num_dim              = 3                               # Number of dimensions
num_bodies           = 2                               # Number of bodies
0pn_terms            = 1                               # Whether to include 0PN (Newtonian) terms
1pn_terms            = 0                               # Whether to include 1PN terms
2pn_terms            = 0                               # Whether to include 2PN terms
2.5pn_terms          = 0                               # Whether to include 2.5PN terms


# -------------------------------------------------------------------------------------------------
# Time parameters
# -------------------------------------------------------------------------------------------------
t_end                = 3500.0                          # Final time
dt                   = 0.1                             # Timestep


# -------------------------------------------------------------------------------------------------
# ODE integrator
# -------------------------------------------------------------------------------------------------
ode_integrator       = rk4                             # ODE integration method


# -------------------------------------------------------------------------------------------------
# Initial conditions
# -------------------------------------------------------------------------------------------------
ic_preset            = binary                          # Initial condition preset
mass1                = 0.25                            # Mass of body 1
mass2                = 0.75                            # Mass of body 2
binary_a             = 40.0                            # Semi-major axis of binary
binary_b             = 30.0                            # Semi-minor axis of binary
binary_f0            = 0.0                             # True anomaly

binary_i             = 1.0                             # Inclination
binary_Omega         = 0.8                             # Longitude of the ascending node
binary_omega         = 3.1                             # Argument of periapsis


# -------------------------------------------------------------------------------------------------
# Output parameters
# -------------------------------------------------------------------------------------------------
dt_save              = 1.0                             # Output times
output = position momentum velocity energy angular_momentum orbit_1_2
orbit_1_2 = separation a_newtonian e_newtonian
