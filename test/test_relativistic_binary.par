# Test for a relativistic binary


# -------------------------------------------------------------------------------------------------
# General parameters
# -------------------------------------------------------------------------------------------------
num_dim              = 3                               # Number of dimensions
num_bodies           = 2                               # Number of bodies
0pn_terms            = 1                               # Whether to include 0PN (Newtonian) terms
1pn_terms            = 1                               # Whether to include 1PN terms
2pn_terms            = 1                               # Whether to include 2PN terms
2.5pn_terms          = 1                               # Whether to include 2.5PN terms


# -------------------------------------------------------------------------------------------------
# Time parameters
# -------------------------------------------------------------------------------------------------
t_end                = 2500.0                          # Final time
dt                   = 0.1                             # Timestep


# -------------------------------------------------------------------------------------------------
# ODE integrator
# -------------------------------------------------------------------------------------------------
ode_integrator       = rk4                             # ODE integration method


# -------------------------------------------------------------------------------------------------
# Merger settings
# -------------------------------------------------------------------------------------------------
merge_activate       = 1                               # Whether to activate mergers
merge_factor         = 2.0                             # Distance at which to merge
remnant_prescription = lz                              # Analytic remnant property prescription


# -------------------------------------------------------------------------------------------------
# Initial conditions
# -------------------------------------------------------------------------------------------------
ic_preset            = binary                          # Initial condition preset
mass1                = 0.9                             # Mass of body 1
mass2                = 0.1                             # Mass of body 2
binary_a             = 15.0                            # Semi-major axis of binary
binary_e             = 0.6                             # Eccentricity of binary
binary_phi0          = 0.4                             # Initial phase of binary

spin1                = 0.3 0.6 0.0                     # Spin of body 1
spin2                = -0.1 0.1 0.7                    # Spin of body 2

# -------------------------------------------------------------------------------------------------
# Output parameters
# -------------------------------------------------------------------------------------------------
dt_save              = 1.0                             # Output times
output = position momentum velocity merger orbit_1_2
orbit_1_2 = separation radial_velocity a_r e_r energy
