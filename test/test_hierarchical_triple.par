# Test for a hierarchical triple

# -------------------------------------------------------------------------------------------------
# General parameters
# -------------------------------------------------------------------------------------------------
num_dim              = 3                               # Number of dimensions
num_bodies           = 3                               # Number of bodies
0pn_terms            = 1                               # Whether to include 0PN (Newtonian) terms
1pn_terms            = 0                               # Whether to include 1PN terms
2pn_terms            = 0                               # Whether to include 2PN terms
2.5pn_terms          = 0                               # Whether to include 2.5PN terms


# -------------------------------------------------------------------------------------------------
# Time parameters
# -------------------------------------------------------------------------------------------------
t_end                = 30000.0                         # Final time
dt                   = 0.1                             # Timestep


# -------------------------------------------------------------------------------------------------
# ODE integrator
# -------------------------------------------------------------------------------------------------
ode_integrator       = rk4                             # ODE integration method


# -------------------------------------------------------------------------------------------------
# Initial conditions
# -------------------------------------------------------------------------------------------------
ic_preset            = hierarchical_triple             # Initial condition preset
mass1                = 0.5                             # Mass of body 1
mass2                = 1.5                             # Mass of body 2
mass3                = 5.0                             # Mass of body 3

binary1_a            = 30.0                            # Semi-major axis of inner binary
binary1_b            = 25.0                            # Semi-minor axis of inner binary
binary1_f0           = 0.4                             # True anomaly of inner binary
binary1_h_hat        = 1.0 0.0 0.0                     # Angular momentum direction of inner binary
binary1_e_hat        = 0.0 0.0 1.0                     # Periapsis direction of inner binary

binary2_e            = 0.5                             # Eccentricity of outer binary
binary2_a            = 400.0	                       # Semi-major axis of outer binary
binary2_f0           = 0.9                             # True anomaly of outer binary
binary2_h_hat        = 0.0 0.0 1.0                     # Angular momentum direction of outer binary
binary2_e_hat        = 1.0 0.0 0.0                     # Periapsis direction of outer binary


# -------------------------------------------------------------------------------------------------
# Output parameters
# -------------------------------------------------------------------------------------------------
dt_save              = 1.0                             # Output times
output = position momentum velocity energy merger
